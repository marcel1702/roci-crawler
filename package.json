{
  "name": "roci-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Diablo-artiges Action-RPG im Universum von The Expanse (privates Fanprojekt) als PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
